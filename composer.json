{
    "name": "postalportal/zip4",
    "description": "Match and standardize US addresses against a local USPS ZIP+4 SQLite database",
    "type": "library",
    "license": "MPL-2.0",
    "keywords": ["usps", "zip4", "zip", "address", "standardization", "pub 28"],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "suggest": {
        "ext-zip": "To build the database with bin/zip4-build"
    },
    "bin": ["bin/zip4-build"],
    "autoload": {
        "psr-4": {
            "PostalPortal\\ZIP4\\": "src/"
        }
    },
    "scripts": {
        "test": ["php tests/run.php", "php tests/build.php"]
    }
}
