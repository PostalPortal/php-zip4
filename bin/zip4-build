 * file, You can obtain one at http://mozilla.org/MPL/2.0/.
 */

/*
 * Builds the ZIP+4 SQLite database from zip-codes.com's downloads
 * (https://www.zip-codes.com/zip-plus-4-database.asp).
 *
 * A PHP port of AddressDatabase's zipdbgen.py: same tables, columns and indexes, so the file works
 * with either. Differences:
 *   - Several archives in one run (the ZIP+4 and 5-digit products together), or the per-state
 *     ZIP4-XX.zip files and the CSVs on their own
 *   - Indexes are built after loading instead of before, which is much faster
 *   - The "addressnumber" index is on AddressPrimaryEvenOdd. zipdbgen.py misspells it AddressPrimaryOddEven,
 *     which SQLite takes as a string literal, so the parity column was never really indexed.
 *   - Also adds the (ZipCode, StName) index postalportal/zip4 looks streets up with
 *   - VACUUM only when dropping old tables left free space, with temp files on disk, not in RAM
 *
 * Tables for a product found in the input are dropped and rebuilt. Other tables are left alone, so
 * running it once with the ZIP+4 product and once with the 5-digit product works too.
 */

// Only ever run from command line, never by a web server
if (PHP_SAPI !== "cli") {
    http_response_code(404);
    exit();
}

const ZIP4_COLUMNS = ["ZipCode" => "char(5)", "UpdateKey" => "varchar(10)", "Action" => "char(1)", "RecordType" => "varchar(1)",
    "CarrierRoute" => "varchar(4)", "StPreDirAbbr" => "varchar(2)", "StName" => "varchar(28)", "StSuffixAbbr" => "varchar(4)",
    "StPostDirAbbr" => "varchar(2)", "AddressPrimaryLowNumber" => "varchar(10)", "AddressPrimaryHighNumber" => "varchar(10)",
    "AddressPrimaryEvenOdd" => "varchar(1)", "BuildingName" => "varchar(40)", "AddressSecAbbr" => "varchar(4)",
    "AddressSecLowNumber" => "varchar(10)", "AddressSecHighNumber" => "varchar(10)", "AddressSecOddEven" => "varchar(1)",
    "Plus4Low" => "varchar(4)", "Plus4High" => "varchar(4)", "BaseAlternateCode" => "varchar(1)", "LACSStatus" => "varchar(1)",
    "GovernmentBuilding" => "varchar(1)", "FinanceNumber" => "varchar(6)", "State" => "varchar(2)", "CountyFIPS" => "varchar(3)",
    "CongressionalDistrict" => "varchar(2)", "MunicipalityKey" => "varchar(6)", "UrbanizationKey" => "varchar(6)",
    "PreferredLastLineKey" => "varchar(6)", "ToLatitude" => "decimal(18, 10)", "FromLatitude" => "decimal(18, 10)",
    "ToLongitude" => "decimal(18, 10)", "FromLongitude" => "decimal(18, 10)", "CensusTract" => "varchar(15)",
    "CensusBlock" => "varchar(15)", "TLID" => "varchar(15)", "LatLonMultiMatch" => "varchar(1)", "StreetFull" => "varchar(36)"];

const ZIP4_INDEXES = [
    "addressnumber" => ["AddressPrimaryLowNumber", "AddressPrimaryHighNumber", "AddressPrimaryEvenOdd"],
    "key" => ["PreferredLastLineKey"],
    "zipcode_route" => ["ZipCode", "CarrierRoute"],
    "state" => ["State"],
    "streetfull_state" => ["StreetFull", "State"],
    "stname_state" => ["StName", "State"],
    "zip" => ["ZipCode"],
    "streetfull_state_zip" => ["StreetFull", "State", "ZipCode"],
    "stname_state_zip" => ["StName", "State", "ZipCode"],
    "idx_zip4_zipcode_stname" => ["ZipCode", "StName"]
];

const ZIPCODES_COLUMNS = ["ZipCode" => "char(5) NOT NULL", "City" => "varchar(35) NULL", "State" => "char(2)",
    "County" => "varchar(45) NULL", "AreaCode" => "varchar(55) NULL", "CityType" => "char(1) NULL",
    "CityAliasAbbreviation" => "varchar(13) NULL", "CityAliasName" => "varchar(35) NULL", "Latitude" => "decimal(12, 6)",
    "Longitude" => "decimal(12, 6)", "TimeZone" => "char(2) NULL", "Elevation" => "int", "CountyFIPS" => "char(5) NULL",
    "DayLightSaving" => "char(1) NULL", "PreferredLastLineKey" => "varchar(10) NULL", "ClassificationCode" => "char(1) NULL",
    "MultiCounty" => "char(1) NULL", "StateFIPS" => "char(2) NULL", "CityStateKey" => "char(6) NULL",
    "CityAliasCode" => "varchar(5) NULL", "PrimaryRecord" => "char(1)", "CityMixedCase" => "varchar(35) NULL",
    "CityAliasMixedCase" => "varchar(35) NULL", "StateANSI" => "varchar(2) NULL", "CountyANSI" => "varchar(3) NULL",
    "FacilityCode" => "varchar(1) NULL", "CityDeliveryIndicator" => "varchar(1) NULL",
    "CarrierRouteRateSortation" => "varchar(1) NULL", "FinanceNumber" => "varchar(6) NULL",
    "UniqueZIPName" => "varchar(1) NULL", "CountyMixedCase" => "varchar(45) NULL"];

const ZIPCODES_INDEXES = [
    "Index_ZIPCodes_ZipCode" => ["ZipCode"], "Index_ZIPCodes_State" => ["State"], "Index_ZIPCodes_County" => ["County"],
    "Index_ZIPCodes_AreaCode" => ["AreaCode"], "Index_ZIPCodes_City" => ["City"], "Index_ZIPCodes_Latitude" => ["Latitude"],
    "Index_ZIPCodes_Longitude" => ["Longitude"], "Index_ZIPCodes_CityAliasName" => ["CityAliasName"],
    "Index_ZIPCodes_CityStateKey" => ["CityStateKey"]
];

const MULTICOUNTY_COLUMNS = ["ZipCode" => "char(5) NOT NULL", "StateFIPS" => "char(2)", "State" => "char(2)",
    "CountyFIPS" => "char(5) NULL", "County" => "varchar(45)", "CountyMixedCase" => "varchar(45)"];

const MULTICOUNTY_INDEXES = [
    "Index_ZIPCodesMultiCounty_ZipCode" => ["ZipCode"], "Index_ZIPCodesMultiCounty_State" => ["State"],
    "Index_ZIPCodesMultiCounty_County" => ["County"]
];

const STATES = [
    "AE" => "Armed Forces Europe, the Middle East, and Canada", "AP" => "Armed Forces Pacific", "AA" => "Armed Forces Americas",
    "AL" => "Alabama", "AK" => "Alaska", "AS" => "American Samoa", "AZ" => "Arizona", "AR" => "Arkansas", "CA" => "California",
    "CO" => "Colorado", "CT" => "Connecticut", "DE" => "Delaware", "DC" => "District of Columbia",
    "FM" => "Federated States of Micronesia", "FL" => "Florida", "GA" => "Georgia", "GU" => "Guam", "HI" => "Hawaii",
    "ID" => "Idaho", "IL" => "Illinois", "IN" => "Indiana", "IA" => "Iowa", "KS" => "Kansas", "KY" => "Kentucky",
    "LA" => "Louisiana", "ME" => "Maine", "MH" => "Marshall Islands", "MD" => "Maryland", "MA" => "Massachusetts",
    "MI" => "Michigan", "MN" => "Minnesota", "MS" => "Mississippi", "MO" => "Missouri", "MT" => "Montana", "NE" => "Nebraska",
    "NV" => "Nevada", "NH" => "New Hampshire", "NJ" => "New Jersey", "NM" => "New Mexico", "NY" => "New York",
    "NC" => "North Carolina", "ND" => "North Dakota", "MP" => "Northern Mariana Islands", "OH" => "Ohio", "OK" => "Oklahoma",
    "OR" => "Oregon", "PW" => "Palau", "PA" => "Pennsylvania", "PR" => "Puerto Rico", "RI" => "Rhode Island",
    "SC" => "South Carolina", "SD" => "South Dakota", "TN" => "Tennessee", "TX" => "Texas", "UT" => "Utah", "VT" => "Vermont",
    "VI" => "Virgin Islands", "VA" => "Virginia", "WA" => "Washington", "WV" => "West Virginia", "WI" => "Wisconsin",
    "WY" => "Wyoming"
];

function usage(): never {
    fwrite(STDERR, <<<TXT
Usage: zip4-build [options] INPUT [INPUT ...] OUTPUT.sqlite

Builds a ZIP+4 SQLite database from zip-codes.com's downloads.

INPUT is any of:
  The ZIP+4 product archive (with a ZIP4-XX.zip inside for each state), or ZIP4-XX.zip files themselves
  The 5-digit product archive (zip-codes-database-STANDARD.csv inside, and the MULTI-COUNTY CSV if it has one),
    or those CSVs themselves

Tables for the products given are dropped and rebuilt; the others in OUTPUT are left as they are.

Options:
  --states=MT,WY   Only load these states' ZIP+4 files (a smaller database for testing)
  --tmp=DIR        Where to unpack each state's ZIP4-XX.zip while it's read (default: the system temp directory).
                   Needs room for the largest one, about 1 GB for California.
  --quiet          No progress output

TXT
    );
    exit(2);
}

$opts = ["states" => null, "tmp" => sys_get_temp_dir(), "quiet" => false];
$positional = [];
foreach (array_slice($argv, 1) as $arg) {
    if ($arg == "--help" || $arg == "-h") {
        usage();
    } else if (str_starts_with($arg, "--states=")) {
        $opts["states"] = array_filter(array_map(fn($s) => strtoupper(trim($s)), explode(",", substr($arg, 9))));
    } else if (str_starts_with($arg, "--tmp=")) {
        $opts["tmp"] = substr($arg, 6);
    } else if ($arg == "--quiet") {
        $opts["quiet"] = true;
    } else if (str_starts_with($arg, "--")) {
        fwrite(STDERR, "Unknown option $arg\n");
        usage();
    } else {
        $positional[] = $arg;
    }
}
if (count($positional) < 2) {
    usage();
}
$output = array_pop($positional);
$inputs = $positional;

function say(string $msg, bool $sameLine = false): void {
    global $opts;
    if (!$opts["quiet"]) {
        echo $sameLine ? "\r$msg\033[K" : "$msg\n";
    }
}

function fail(string $msg): never {
    fwrite(STDERR, "\n$msg\n");
    exit(1);
}

/*
 * Find the files. Each source is ["kind" => zip4|zip5|multicounty, "label", "open" => fn() => [stream, cleanup]]
 */

function classify(string $name): ?string {
    $base = basename(str_replace("\\", "/", $name));
    if (preg_match('/^ZIP4-([A-Z]{2})\.zip$/i', $base)) {
        return "zip4";
    }
    if (preg_match('/\.csv$/i', $base) && stripos($base, "MULTI-COUNTY") !== false) {
        return "multicounty";
    }
    if (preg_match('/^zip-codes-database-[A-Z0-9_\-]+\.csv$/i', $base)) {
        return "zip5";
    }
    return null;
}

function stateOf(string $name): string {
    preg_match('/ZIP4-([A-Z]{2})\.zip$/i', basename($name), $m);
    return strtoupper($m[1] ?? "");
}

/** Copies a zip entry to a temp file (ZipArchive can only open real files) */
function extractToTemp(ZipArchive $zip, string $entry, string $tmpDir): string {
    $tmp = tempnam($tmpDir, "zip4-");
    $in = $zip->getStream($entry);
    $out = fopen($tmp, "wb");
    if ($in === false || $out === false || stream_copy_to_stream($in, $out) === false) {
        fail("Couldn't unpack $entry to $tmpDir");
    }
    fclose($in);
    fclose($out);
    return $tmp;
}

/** A state's ZIP4-XX.zip holds one CSV: open it (the first entry, as zipdbgen.py does) */
function openStateZip(string $path, string $label): array {
    $inner = new ZipArchive();
    if ($inner->open($path, ZipArchive::RDONLY) !== true || $inner->numFiles < 1) {
        fail("$label isn't a readable zip file");
    }
    $stream = $inner->getStream($inner->getNameIndex(0));
    if ($stream === false) {
        fail("Couldn't read the CSV in $label");
    }
    return [$stream, function () use ($inner, $stream) {
            fclose($stream);
            $inner->close();
        }];
}

$sources = [];
foreach ($inputs as $input) {
    if (!is_file($input)) {
        fail("$input not found");
    }
    $kind = classify($input);
    if ($kind == "zip4") {
        $sources[] = ["kind" => "zip4", "label" => basename($input), "state" => stateOf($input), "open" => fn() => openStateZip($input, basename($input))];
    } else if ($kind !== null) {
        $sources[] = ["kind" => $kind, "label" => basename($input), "open" => function () use ($input) {
                $h = fopen($input, "rb");
                return [$h, fn() => fclose($h)];
            }];
    } else {
        $zip = new ZipArchive();
        if ($zip->open($input, ZipArchive::RDONLY) !== true) {
            fail("$input isn't a zip archive, a ZIP4-XX.zip, or one of the zip-codes.com CSVs");
        }
        $found = 0;
        for ($i = 0; $i < $zip->numFiles; $i++) {
            $entry = $zip->getNameIndex($i);
            $kind = classify($entry);
            if ($kind === null) {
                continue;
            }
            $found++;
            $label = basename($input) . ": " . basename($entry);
            if ($kind == "zip4") {
                $sources[] = ["kind" => "zip4", "label" => $label, "state" => stateOf($entry), "open" => function () use ($input, $entry, $label) {
                        global $opts;
                        $outer = new ZipArchive();
                        $outer->open($input, ZipArchive::RDONLY);
                        $tmp = extractToTemp($outer, $entry, $opts["tmp"]);
                        $outer->close();
                        [$stream, $close] = openStateZip($tmp, $label);
                        return [$stream, function () use ($close, $tmp) {
                                $close();
                                unlink($tmp);
                            }];
                    }];
            } else {
                $sources[] = ["kind" => $kind, "label" => $label, "open" => function () use ($input, $entry, $label) {
                        $z = new ZipArchive();
                        $z->open($input, ZipArchive::RDONLY);
                        $h = $z->getStream($entry);
                        if ($h === false) {
                            fail("Couldn't read $label");
                        }
                        return [$h, function () use ($z, $h) {
                                fclose($h);
                                $z->close();
                            }];
                    }];
            }
        }
        $zip->close();
        if ($found == 0) {
            fail("Nothing from zip-codes.com in $input (expected ZIP4-XX.zip files or zip-codes-database-*.csv)");
        }
    }
}
if ($opts["states"] !== null) {
    $sources = array_values(array_filter($sources, fn($s) => $s["kind"] != "zip4" || in_array($s["state"], $opts["states"])));
}
$kinds = array_unique(array_column($sources, "kind"));
if (count($sources) == 0) {
    fail("Nothing to load" . ($opts["states"] !== null ? " for those states" : ""));
}

/*
 * The database
 */

$isNew = !file_exists($output) || filesize($output) == 0;
$db = new PDO("sqlite:$output");
$db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
if ($isNew) {
    // Big pages suit a big read-mostly file. Only takes effect before the first table is made.
    $db->exec("PRAGMA page_size = 65536");
}
// Speed over safety while loading, as zipdbgen.py does: a crash means running it again, not a corrupt live file
$db->exec("PRAGMA journal_mode = OFF; PRAGMA synchronous = OFF; PRAGMA temp_store = MEMORY; PRAGMA cache_size = -524288;
    PRAGMA locking_mode = EXCLUSIVE; PRAGMA mmap_size = 1073741824; PRAGMA foreign_keys = OFF;");

function createTable(PDO $db, string $table, array $columns): void {
    $db->exec("DROP TABLE IF EXISTS \"$table\"");
    $cols = [];
    foreach ($columns as $name => $type) {
        $cols[] = "\"$name\" $type";
    }
    $db->exec("CREATE TABLE \"$table\" (\n" . implode(",\n", $cols) . "\n)");
}

function createIndexes(PDO $db, string $table, array $indexes): void {
    foreach ($indexes as $name => $columns) {
        say("Indexing $table ($name)...", true);
        $db->exec("DROP INDEX IF EXISTS \"$name\"");
        $db->exec("CREATE INDEX \"$name\" ON \"$table\" (\"" . implode("\", \"", $columns) . "\")");
    }
    say("Indexed $table", true);
    say("");
}

/**
 * Loads a CSV stream into a table, matching CSV columns to table columns by header name (as pandas'
 * to_sql does). Values go in as text, so leading zeros survive; empty fields are empty strings.
 */
function loadCsv(PDO $db, $stream, string $label, string $table, array $columns, ?callable $rowFn, int &$total): int {
    $header = fgetcsv($stream, null, ",", "\"", "");
    if ($header === false || $header === [null]) {
        fail("$label is empty");
    }
    $header[0] = preg_replace('/^\xEF\xBB\xBF/', "", $header[0]); // BOM
    $header = array_map("trim", $header);
    $positions = [];
    foreach ($header as $i => $name) {
        if (array_key_exists($name, $columns)) {
            $positions[$name] = $i;
        }
    }
    $unknown = array_diff($header, array_keys($columns));
    if (count($unknown) > 0) {
        say("  $label: ignoring columns not in the $table table: " . implode(", ", $unknown));
    }
    if (!isset($positions["ZipCode"])) {
        fail("$label has no ZipCode column; is it a zip-codes.com file? Header: " . implode(",", array_slice($header, 0, 8)));
    }
    $names = array_keys($columns);
    $insert = $db->prepare("INSERT INTO \"$table\" (\"" . implode("\", \"", $names) . "\") VALUES (" . implode(",", array_fill(0, count($names), "?")) . ")");
    $count = 0;
    $db->beginTransaction();
    while (($fields = fgetcsv($stream, null, ",", "\"", "")) !== false) {
        if ($fields === [null]) {
            continue; // blank line
        }
        $row = [];
        foreach ($names as $name) {
            $row[$name] = isset($positions[$name]) ? ($fields[$positions[$name]] ?? "") : "";
        }
        if ($rowFn) {
            $row = $rowFn($row);
        }
        $insert->execute(array_values($row));
        $count++;
        $total++;
        if ($count % 100000 == 0) {
            $db->commit();
            $db->beginTransaction();
            say("Loading $label ... " . number_format($count) . " rows (" . number_format($total) . " in $table)", true);
        }
    }
    $db->commit();
    say("Loaded $label: " . number_format($count) . " rows", true);
    say("");
    return $count;
}

$started = microtime(true);
$summary = [];

if (in_array("zip4", $kinds)) {
    say("Creating ZIP4 table");
    createTable($db, "ZIP4", ZIP4_COLUMNS);
    $total = 0;
    // StreetFull is the whole street as one string: N MAIN ST, US HIGHWAY 12 W
    $streetFull = function (array $row): array {
        $row["StreetFull"] = implode(" ", array_filter([$row["StPreDirAbbr"], $row["StName"], $row["StSuffixAbbr"], $row["StPostDirAbbr"]], fn($v) => $v !== ""));
        return $row;
    };
    foreach ($sources as $src) {
        if ($src["kind"] != "zip4") {
            continue;
        }
        say("Loading $src[label] ...", true);
        [$stream, $close] = ($src["open"])();
        loadCsv($db, $stream, $src["label"], "ZIP4", ZIP4_COLUMNS, $streetFull, $total);
        $close();
    }
    createIndexes($db, "ZIP4", ZIP4_INDEXES);
    $summary[] = number_format($total) . " ZIP+4 records";
}

if (in_array("zip5", $kinds)) {
    say("Creating ZIPCodes and States tables");
    createTable($db, "ZIPCodes", ZIPCODES_COLUMNS);
    $db->exec("DROP TABLE IF EXISTS States");
    $db->exec("CREATE TABLE States (code TEXT, name TEXT)");
    $ins = $db->prepare("INSERT INTO States (code, name) VALUES (?, ?)");
    foreach (STATES as $code => $name) {
        $ins->execute([$code, $name]);
    }
    $total = 0;
    foreach ($sources as $src) {
        if ($src["kind"] == "zip5") {
            [$stream, $close] = ($src["open"])();
            loadCsv($db, $stream, $src["label"], "ZIPCodes", ZIPCODES_COLUMNS, null, $total);
            $close();
        }
    }
    createIndexes($db, "ZIPCodes", ZIPCODES_INDEXES);
    $summary[] = number_format($total) . " 5-digit ZIP records";
}

if (in_array("multicounty", $kinds)) {
    say("Creating ZIPCodesMultiCounty table");
    createTable($db, "ZIPCodesMultiCounty", MULTICOUNTY_COLUMNS);
    $total = 0;
    foreach ($sources as $src) {
        if ($src["kind"] == "multicounty") {
            [$stream, $close] = ($src["open"])();
            loadCsv($db, $stream, $src["label"], "ZIPCodesMultiCounty", MULTICOUNTY_COLUMNS, null, $total);
            $close();
        }
    }
    createIndexes($db, "ZIPCodesMultiCounty", MULTICOUNTY_INDEXES);
    $summary[] = number_format($total) . " multi-county records";
}

// Dropping the old tables leaves their pages free inside the file: VACUUM gives that space back.
// Its scratch copy goes to disk, not RAM (with temp_store = MEMORY a national file would need gigabytes of RAM).
$free = (int) $db->query("PRAGMA freelist_count")->fetchColumn();
if ($free > 0) {
    say("Compacting the database (VACUUM, needs free disk space about the size of the file)...");
    $db->exec("PRAGMA temp_store = FILE");
    $db->exec("VACUUM");
}
say("Analyzing...");
$db->exec("ANALYZE; PRAGMA optimize;");
$db = null;

say("Done in " . round(microtime(true) - $started) . "s: " . implode(", ", $summary) . ". Saved to $output");
